  skenarioDialog:
  - siapaYangBicara: 1
    namaKarakter: Lala
    teksDialog: Halo, Arthur. Sebelum memilih warna, aku menentukan siapa yang akan
      membaca desain ini dan pesan apa yang perlu mereka pahami.
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
