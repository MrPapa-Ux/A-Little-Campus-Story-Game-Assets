  m_Script: {fileID: 11500000, guid: 70ec8f2f2387ce9469849f35f84d51e0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MateriKuliahNpc
  idCatatan: materi_ekonomi_pilihan
  judulCatatan: 'Ekonomi: biaya peluang'
  ringkasan: 'Biaya peluang adalah nilai alternatif terbaik yang dilepas ketika kita
    memilih sesuatu. Bukan jumlah semua pilihan yang tidak diambil.


    Misalnya
    kamu punya satu jam untuk belajar atau bekerja sambilan. Memilih belajar berarti
    melepaskan manfaat terbaik dari bekerja pada jam itu.


    Keputusan yang masuk
    akal bergantung pada tujuan dan keadaan. Harga paling murah belum tentu memberi
    manfaat terbesar.'
  buku: {fileID: 390398959}
