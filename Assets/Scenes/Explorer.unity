  skenarioDialog:
  - siapaYangBicara: 1
    namaKarakter: Dandi
    teksDialog: Arthur, bagaimana perkembangan penulisanmu?
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  - siapaYangBicara: 0
    namaKarakter: Arthur
    teksDialog: Masih kukerjakan. Ada beberapa bagian yang perlu diperbaiki.
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  - siapaYangBicara: 1
    namaKarakter: Dandi
    teksDialog: Sudah dua bulan, kan? Bagian mana yang sudah selesai?
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  - siapaYangBicara: 0
    namaKarakter: Arthur
    teksDialog: Belum sebanyak yang kurencanakan.
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  - siapaYangBicara: 1
    namaKarakter: Dandi
    teksDialog: Coba siapkan bagian yang sudah ada untuk dibahas dengan dosen.
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  - siapaYangBicara: 0
    namaKarakter: Arthur
    teksDialog: Iya. Nanti kurapikan lagi.
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
