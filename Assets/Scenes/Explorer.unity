  m_Script: {fileID: 11500000, guid: 70ec8f2f2387ce9469849f35f84d51e0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MateriKuliahNpc
  idCatatan: materi_filkom_algoritma
  judulCatatan: 'Ilmu Komputer: algoritma dan pengujian'
  ringkasan: 'Misalnya mencari nilai terbesar dari tiga angka. Simpan angka pertama
    sebagai nilai sementara, lalu bandingkan dengan dua angka lainnya.


    Program
    juga perlu menangani kasus khusus. Bagaimana kalau semua angkanya sama, atau
    ada angka negatif? Kasus seperti itu perlu diuji.


    Sebelum menulis kode,
    coba tulis langkahnya dengan bahasa biasa. Sesudah itu, jalankan beberapa contoh
    dan periksa hasil yang diharapkan.'
  buku: {fileID: 390398959}
