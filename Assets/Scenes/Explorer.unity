  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TitikQuestTitipanArthur
  quest: {fileID: 717036815}
  titikBarang: 0
  visualBarang: {fileID: 0}
  sebelumTerima:
  - siapaYangBicara: 1
    namaKarakter: Rani
    teksDialog: Arthur, boleh bantu mengambil buku sketsa milikku? Cari di sisi koridor
      kanan GK1 lantai 1, di antara mahasiswa Ekonomi dan DKV.
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  - siapaYangBicara: 0
    namaKarakter: Arthur
    teksDialog: Baik, aku akan mengambilnya dan kembali ke sini. Aku bisa melihat
      petunjuknya di Tugas pada HP.
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  sedangMencari:
  - siapaYangBicara: 1
    namaKarakter: Rani
    teksDialog: Terima kasih sudah membantu. Cari di sisi koridor kanan GK1 lantai
      1, di antara mahasiswa Ekonomi dan DKV. Setelah diambil, barangnya akan muncul
      di Tas pada HP.
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  siapDiserahkan:
  - siapaYangBicara: 0
    namaKarakter: Arthur
    teksDialog: Ini buku sketsa yang tadi kamu titipkan.
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  - siapaYangBicara: 1
    namaKarakter: Rani
    teksDialog: Terima kasih, Arthur! Barangnya sudah kuterima. Tugasmu selesai.
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  sesudahSelesai:
  - siapaYangBicara: 1
    namaKarakter: Rani
    teksDialog: Terima kasih sudah mengembalikan buku sketsa. Semoga tugas kuliahmu
      juga lancar!
    teksTombolLanjut: Lanjut
