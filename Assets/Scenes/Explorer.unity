  quest: {fileID: 717036816}
  titikBarang: 0
  visualBarang: {fileID: 0}
  sebelumTerima:
  - siapaYangBicara: 1
    namaKarakter: Damar
    teksDialog: Arthur, boleh bantu mengambil hard disk praktikum milikku? Cari di
      selasar GA lantai 1, dekat sisi kedatangan dari GK1.
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  - siapaYangBicara: 0
    namaKarakter: Arthur
    teksDialog: Baik, aku akan mengambilnya dan kembali ke sini. Aku bisa melihat
      petunjuknya di Tugas pada HP.
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  sedangMencari:
  - siapaYangBicara: 1
    namaKarakter: Damar
    teksDialog: Terima kasih sudah membantu. Cari di selasar GA lantai 1, dekat sisi
      kedatangan dari GK1. Setelah diambil, barangnya akan muncul di Tas pada HP.
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
