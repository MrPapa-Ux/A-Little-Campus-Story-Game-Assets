  m_Script: {fileID: 11500000, guid: 70ec8f2f2387ce9469849f35f84d51e0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MateriKuliahNpc
  idCatatan: materi_ekonomi_anggaran
  judulCatatan: 'Ekonomi: anggaran dan arus kas'
  ringkasan: 'Pisahkan kebutuhan rutin, pengeluaran yang berubah-ubah, dan dana untuk
    keperluan tak terduga. Sesuaikan dengan keadaanmu.


    Contohnya, kalau pemasukan
    100 dan pengeluaran 80, selisih kasnya 20. Selisih kas itu belum otomatis sama
    dengan laba dalam akuntansi.


    Dalam usaha, laba juga mempertimbangkan pendapatan
    dan beban pada periode yang sesuai. Waktu menerima atau membayar uang bisa berbeda.'
  buku: {fileID: 390398959}
