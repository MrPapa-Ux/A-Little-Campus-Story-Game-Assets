  m_EditorClassIdentifier: Assembly-CSharp::MateriKuliahNpc
  idCatatan: materi_perawat_proses
  judulCatatan: 'Keperawatan: proses asuhan'
  ringkasan: 'Tahap dasarnya adalah pengkajian, diagnosis keperawatan, perencanaan,
    pelaksanaan, dan evaluasi.


    Diagnosis keperawatan membahas respons atau
    kebutuhan pasien. Itu berbeda dari penetapan diagnosis medis penyakit.


    Evaluasi
    memeriksa apakah tujuan asuhan tercapai. Jika belum, rencana perlu ditinjau kembali
    berdasarkan data dan arahan pembimbing.'
  buku: {fileID: 390398959}
