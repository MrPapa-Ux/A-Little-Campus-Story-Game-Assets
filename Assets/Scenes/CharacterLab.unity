    berteriak: 0
    kekuatanTeriak: 1
  - siapaYangBicara: 0
    namaKarakter: Arthur
    potretPembicara: {fileID: 0}
    teksDialog: Masih kukerjakan. Ada beberapa bagian yang perlu diperbaiki.
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
