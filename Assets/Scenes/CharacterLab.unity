  m_Script: {fileID: 11500000, guid: 70ec8f2f2387ce9469849f35f84d51e0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MateriKuliahNpc
  idCatatan: materi_dkv_hierarki
  judulCatatan: 'DKV: hierarki visual dan keterbacaan'
  ringkasan: 'Hierarki visual membantu pembaca tahu apa yang dilihat lebih dulu.
    Judul, informasi utama, dan keterangan tambahan perlu punya prioritas.


    Ukuran
    huruf, jarak, dan kontras dapat membedakan prioritas itu. Kalau semua elemen
    sama menonjol, pembaca malah kebingungan.


    Ruang kosong di antara elemen
    desain dapat membantu keterbacaan. Yang penting ruangnya punya tujuan dan pesannya
    tetap jelas.'
  buku: {fileID: 390398959}
