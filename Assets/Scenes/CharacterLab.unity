MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2242247682112280744}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a6f2161909c85f646b55b22913dfa5cb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AreaInteraksi
  idTempat: NPC_Mahasiswa
  tipeInteraksi: 0
  potretDialog: {fileID: 21300000, guid: ce917edfabfe7784b85b31ca3446f4cb, type: 3}
  tampilkanTombolKeluar: 1
  skenarioDialog:
  - siapaYangBicara: 1
    namaKarakter: Sir George
    potretPembicara: {fileID: 0}
    teksDialog: Hai, saya Sir George M. W. Tangka.
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  - siapaYangBicara: 1
    namaKarakter: Niko
    potretPembicara: {fileID: 1565207551, guid: 1550e4d48747392499835ae702b8d5c3, type: 3}
    teksDialog: Sir! Aku mau join VOCS! Voice Of Computer Science di semester depan;
      lumayan lah, dapat nilai bonus.
    teksTombolLanjut: Next ->
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  - siapaYangBicara: 1
    namaKarakter: Sir George
    potretPembicara: {fileID: 0}
    teksDialog: Kau kalau ikut itu bukan fokus untuk cari nilai, dan itu juga nilai
      rekomendasi, jadi tergantung dosen mau menambahkannya sebagai nilai bonus atau
      tidak.
    teksTombolLanjut: Selesai
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  daftarOpsi: []
  batasJarakMendatar: 0
