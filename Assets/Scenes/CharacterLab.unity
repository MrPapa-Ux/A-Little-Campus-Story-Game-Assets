--- !u!114 &801550018
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 801550017}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 333427f2d211320458686e0365027359, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuestKontakArthur
  misi:
  - id: kontak_kampus_0
    pengirim: Bimo
    judul: Titip kabar ke Rina
    permintaan: Kalau lewat GK1 lantai satu sisi kiri, tolong tanya Rina dia sudah
      baca pesanku belum. Centang dua rupanya belum termasuk jawaban.
    laporan: Rina sudah membaca pesannya. Katanya dia memang belum membalas. Centang
      dua ternyata jujur.
    balasan: Oke, terima kasih. Satu urusan selesai. Lumayan, tidak jadi bahan pikiran
      sampai malam.
    namaHadiah: Buku Saku
    deskripsiHadiah: Kenang-kenangan kecil dari Bimo.
    ikon: {fileID: 21300000, guid: af4c6da7d95834044a01d1c1181dd3ae, type: 3}
    tujuan: {fileID: 179025337}
  - id: kontak_kampus_1
    pengirim: Nisay
    judul: Catatan yang sudah dibaca
    permintaan: Temui Mika di kelas GK2. Tanya catatannya sudah dibaca atau baru
      dipindah ke folder yang namanya 'nanti'. Habis itu kabari aku.
    laporan: Mika baru membaca judulnya. Isinya menyusul hari ini, katanya.
    balasan: Oke, terima kasih. Satu urusan selesai. Lumayan, tidak jadi bahan pikiran
      sampai malam.
    namaHadiah: Pembatas Buku
    deskripsiHadiah: Kenang-kenangan kecil dari Nisay.
    ikon: {fileID: 21300000, guid: 1d3505758c2b27f43879a734b5e8c714, type: 3}
    tujuan: {fileID: 1717927376}
  - id: kontak_kampus_2
    pengirim: Atan
    judul: Masih sempat, katanya
    permintaan: Kalau ketemu Irene yang lari di GA lantai satu, tanya dia masih sempat
      masuk kelas atau sedang mencoba menghentikan waktu. Kabari aku saja.
    laporan: Irene masih menuju kelas. Dia merasa masih sempat. Aku tidak ikut menjamin
      hitungannya.
    balasan: Oke, terima kasih. Satu urusan selesai. Lumayan, tidak jadi bahan pikiran
      sampai malam.
    namaHadiah: Gantungan Kunci
    deskripsiHadiah: Kenang-kenangan kecil dari Atan.
    ikon: {fileID: 21300000, guid: dd5679b6a6579424b86dcc0250ac5a4c, type: 3}
    tujuan: {fileID: 489448907}
  - id: kontak_kampus_3
    pengirim: Livia
    judul: Tetangga lantai dua
    permintaan: Tolong cek Laras di lorong Jasmine lantai dua. Aku menunggu kabarnya.
      Naik satu lantai ternyata lebih cepat daripada menunggu balasan.
    laporan: Laras ada di lantai dua. HP-nya diam. Orangnya tidak.
    balasan: Oke, terima kasih. Satu urusan selesai. Lumayan, tidak jadi bahan pikiran
      sampai malam.
    namaHadiah: Pin Kampus
    deskripsiHadiah: Kenang-kenangan kecil dari Livia.
    ikon: {fileID: 21300000, guid: 723c744d3ccd42144bc621d26bb8bbd3, type: 3}
    tujuan: {fileID: 171355209}
  - id: kontak_kampus_4
    pengirim: Naya
    judul: Kabar dari Sela
    permintaan: Kalau sudah masuk Jasmine, temui Sela di lorong lantai satu lalu
      kabari aku. Dia menunggu di dekat ujung lorong. Pesan singkat kadang tetap
      perlu perantara.
    laporan: Sela sudah kutemui di lantai tiga. Aku juga sudah berhenti naik.
    balasan: Oke, terima kasih. Satu urusan selesai. Lumayan, tidak jadi bahan pikiran
      sampai malam.
    namaHadiah: Kartu Pos Jasmine
    deskripsiHadiah: Kenang-kenangan kecil dari Naya.
    ikon: {fileID: 21300000, guid: 3467b8d0ec18fe64ab9da37097cadca2, type: 3}
    tujuan: {fileID: 1272680730}
  buku: {fileID: 390398959}
