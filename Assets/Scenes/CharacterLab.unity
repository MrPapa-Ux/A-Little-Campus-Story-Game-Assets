  m_Script: {fileID: 11500000, guid: 94497ab6e0bce7f4f8db94f4c46243d4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TitikQuestTitipanArthur
  quest: {fileID: 717036816}
  titikBarang: 0
  visualBarang: {fileID: 0}
  sebelumTerima:
  - siapaYangBicara: 1
    namaKarakter: Damar
    potretPembicara: {fileID: 0}
    teksDialog: Arthur, boleh bantu mengambil hard disk praktikum milikku? Cari di
      selasar GA lantai 1, dekat sisi kedatangan dari GK1.
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  - siapaYangBicara: 0
    namaKarakter: Arthur
    potretPembicara: {fileID: 0}
    teksDialog: Baik, aku akan mengambilnya dan kembali ke sini. Aku bisa melihat
      petunjuknya di Tugas pada HP.
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  sedangMencari:
  - siapaYangBicara: 1
    namaKarakter: Damar
    potretPembicara: {fileID: 0}
    teksDialog: Terima kasih sudah membantu. Cari di selasar GA lantai 1, dekat sisi
      kedatangan dari GK1. Setelah diambil, barangnya akan muncul di Tas pada HP.
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  siapDiserahkan:
  - siapaYangBicara: 0
    namaKarakter: Arthur
    potretPembicara: {fileID: 0}
    teksDialog: Ini hard disk praktikum yang tadi kamu titipkan.
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  - siapaYangBicara: 1
    namaKarakter: Damar
    potretPembicara: {fileID: 0}
    teksDialog: Terima kasih, Arthur! Barangnya sudah kuterima. Tugasmu selesai.
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  sesudahSelesai:
  - siapaYangBicara: 1
    namaKarakter: Damar
    potretPembicara: {fileID: 0}
    teksDialog: Terima kasih sudah mengembalikan hard disk praktikum. Semoga tugas
      kuliahmu juga lancar!
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
