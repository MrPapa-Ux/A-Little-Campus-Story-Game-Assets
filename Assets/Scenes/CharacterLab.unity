  idTempat: Raka - Ilmu Komputer
  tipeInteraksi: 0
  potretDialog: {fileID: 21300000, guid: 595e561788cbc254c8a4ac56c6a827ae, type: 3}
  tampilkanTombolKeluar: 1
  skenarioDialog:
  - siapaYangBicara: 1
    namaKarakter: Glen
    potretPembicara: {fileID: 0}
    teksDialog: Ada temenku yang neneknya meninggal...
    teksTombolLanjut: "Lanjut \u2192"
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  - siapaYangBicara: 1
    namaKarakter: Glen
    potretPembicara: {fileID: 0}
    teksDialog: Tapi, aku mau menyemangatinya. Dan tapi juga, aku tak tahu harus
      membantu dengan apa.
    teksTombolLanjut: "Lanjut \u2192"
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  - siapaYangBicara: 1
    namaKarakter: Glen
    potretPembicara: {fileID: 0}
    teksDialog: Apalagi aku lagi sibuk skripsi ya kan. Jadi, kurasa kubantu dalam
      doa, dan turut berduka cita aja udah cukup kan, ya?
    teksTombolLanjut: Selesai
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  daftarOpsi: []
  batasJarakMendatar: 0
