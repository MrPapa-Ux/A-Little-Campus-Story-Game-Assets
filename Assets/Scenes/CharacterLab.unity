  skenarioDialog:
  - siapaYangBicara: 1
    namaKarakter: Bima
    potretPembicara: {fileID: 0}
    teksDialog: Arthur, pernah memilih antara membeli sesuatu dan menabung? Ekonomi
      membantu kita memahami pilihan ketika sumber daya terbatas.
    teksTombolLanjut: Lanjut
