    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
    durasiEmote: 1.5
    akhiriSetelahEmote: 0
    ubahEkspresi: 0
    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  - siapaYangBicara: 0
