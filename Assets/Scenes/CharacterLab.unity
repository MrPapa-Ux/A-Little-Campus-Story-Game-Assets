    ekspresi: 0
    berteriak: 0
    kekuatanTeriak: 1
  - siapaYangBicara: 1
    namaKarakter: Dandi
    potretPembicara: {fileID: 0}
    teksDialog: Sudah dua bulan, kan? Bagian mana yang sudah selesai?
    teksTombolLanjut: Lanjut
    picuEmoteSetelahIni: 0
    spriteEmote: {fileID: 0}
